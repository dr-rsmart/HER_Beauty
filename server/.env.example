# BookingTrack server configuration template
# Copy to server/.env and fill in real values. NEVER commit the real .env.

DATABASE_URL="postgresql://postgres:password@localhost:5433/bookingtrack_pre-prod?schema=public"
MIGRATE_DATABASE_URL="postgresql://postgres:password@localhost:5433/bookingtrack_pre-prod?schema=public"

# JWT signing secret — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=4000
CORS_ORIGIN="http://localhost:5173"
CRON_TIMEZONE="Africa/Johannesburg"
REDIS_URL="redis://127.0.0.1:6379"
PERF_TEST_SECRET=""
