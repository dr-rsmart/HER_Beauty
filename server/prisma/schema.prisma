// BookingTrack — Prisma Schema
// Combines the Base44 BookingTrack domain (Provider, Service, Professional, Slot, Booking)
// with TimeTrack's enterprise multi-tenant identity, RBAC, audit trail, and cron locks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  master
  admin
  manager
  employee
  customer
}

enum ProviderStatus {
  published
  draft
}

enum SlotStatus {
  open
  booked
  blocked
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

// ─────────────────────────────────────────────────────────────
// Identity & Multi-Tenant Business Providers
// ─────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  fullName            String
  phone               String?
  role                Role      @default(customer)
  passwordHash        String?
  mustChangePassword  Boolean   @default(false)
  pwdEpoch            Int       @default(0)
  providerId          String?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  provider       Provider?  @relation("ProviderUsers", fields: [providerId], references: [id], onDelete: SetNull)
  ownedProviders Provider[] @relation("ProviderOwner")
  bookings       Booking[]  @relation("CustomerBookings")

  @@index([providerId])
  @@index([role])
}

model Provider {
  id                 String         @id @default(cuid())
  name               String
  category           String         @default("Salon")
  tagline            String?        @default("")
  about              String?        @default("")
  phone              String?        @default("")
  email              String?        @default("")
  website            String?        @default("")
  street             String?        @default("")
  city               String?        @default("")
  postcode           String?        @default("")
  country            String         @default("South Africa")
  coverImage         String?        @default("")
  workingHours       Json           @default("[]")
  ownerEmail         String
  ownerUserId        String?
  status             ProviderStatus @default(published)
  isActive           Boolean        @default(true)
  billingTier        String         @default("standard")
  vatNumber          String?        @default("")
  registrationNumber String?        @default("")
  primaryContactName String?        @default("")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  owner         User?          @relation("ProviderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  users         User[]         @relation("ProviderUsers")
  services      Service[]
  professionals Professional[]
  slots         Slot[]
  bookings      Booking[]
  auditLogs     AuditLog[]

  @@index([status, isActive])
  @@index([category, status])
  @@index([city])
  @@index([ownerEmail])
  @@index([ownerUserId])
}

// ─────────────────────────────────────────────────────────────
// Services & Professionals
// ─────────────────────────────────────────────────────────────

model Service {
  id              String   @id @default(cuid())
  providerId      String
  name            String
  categoryName    String   @default("Natural Hair & Treatments")
  stream          String   @default("salon")
  description     String?  @default("")
  durationMinutes Int      @default(30)
  price           Decimal? @db.Decimal(10, 2)
  priceNote       String?  @default("")
  imageUrl        String?  @default("")
  popular         Boolean  @default(false)
  professionalIds String[] @default([])
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slots    Slot[]
  bookings Booking[]

  @@index([providerId, active])
  @@index([providerId, name])
}

model Professional {
  id              String   @id @default(cuid())
  providerId      String
  name            String
  email           String?
  title           String?  @default("")
  bio             String?  @default("")
  photoUrl        String?  @default("")
  pathwayStage    String   @default("GROW")
  pathwayRole     String   @default("Senior Stylist")
  specialties     String[] @default([])
  rating          Float    @default(4.95)
  reviewCount     Int      @default(48)
  experienceYears Int      @default(4)
  commissionRate  Float    @default(0.45)
  leaves          Json     @default("[]")
  serviceIds      String[] @default([])
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slots    Slot[]
  bookings Booking[]

  @@index([providerId, active])
  @@index([providerId, name])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Availability Slots & Bookings
// ─────────────────────────────────────────────────────────────

model Slot {
  id             String     @id @default(cuid())
  providerId     String
  professionalId String
  serviceId      String?
  date           String // "YYYY-MM-DD"
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  status         SlotStatus @default(open)
  bookingId      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([providerId, professionalId, date, startTime])
  @@index([providerId, date, status])
  @@index([providerId, professionalId, date])
  @@index([date, status])
}

model Booking {
  id               String        @id @default(cuid())
  referenceCode    String        @default("")
  providerId       String
  providerName     String
  serviceId        String?
  serviceName      String
  professionalId   String?
  professionalName String?
  slotId           String?
  customerId       String?
  customerName     String
  customerEmail    String
  customerPhone    String?       @default("")
  date             String // "YYYY-MM-DD"
  startTime        String // "HH:mm"
  endTime          String // "HH:mm"
  price            Decimal?      @db.Decimal(10, 2)
  depositAmount    Decimal?      @db.Decimal(10, 2)
  promoCode        String?       @default("")
  discountPercent  Int           @default(0)
  popiaConsent     Boolean       @default(true)
  notes            String?       @default("")
  status           BookingStatus @default(confirmed)
  reminderSentAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  customer     User?         @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([providerId, date, status])
  @@index([providerId, status])
  @@index([customerId, date])
  @@index([customerEmail, date])
  @@index([slotId])
}

// ─────────────────────────────────────────────────────────────
// Floor 1 — HER Beauty Domain (Specials, Broadcasts, Contracts, Loyalty)
// ─────────────────────────────────────────────────────────────

model SpecialOffer {
  id                   String   @id @default(cuid())
  providerId           String?
  title                String
  code                 String   @unique
  discountPercentage   Int      @default(15)
  description          String   @default("")
  validFrom            String   @default("2026-01-01")
  validUntil           String   @default("2026-12-31")
  bannerImage          String   @default("")
  featuredOnLanding    Boolean  @default(true)
  targetAudience       String   @default("all")
  applicableServiceIds String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([providerId])
}

model BroadcastMessage {
  id          String   @id @default(cuid())
  providerId  String?
  senderId    String
  senderRole  String   @default("admin")
  targetGroup String   @default("all_customers")
  subject     String
  body        String
  channel     String   @default("in_app")
  sentAt      DateTime @default(now())

  @@index([providerId, sentAt])
}

model StylistContract {
  id                      String   @id @default(cuid())
  providerId              String?
  professionalId          String?
  stylistName             String
  contractType            String   @default("permanent")
  startDate               String
  endDate                 String?
  commissionRate          Float    @default(0.45)
  pathwayStage            String   @default("GROW")
  mentorshipHoursPerMonth Int      @default(15)
  probationEndsAt         String?
  status                  String   @default("active")
  signedAt                String?
  documentRef             String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([providerId])
  @@index([professionalId])
}

model ProgrammeAgreement {
  id                String   @id @default(cuid())
  providerId        String?
  cohort            String
  name              String
  startDate         String
  endDate           String
  capacity          Int      @default(6)
  enrolledNames     String[] @default([])
  mentorNames       String[] @default([])
  curriculumModules String[] @default([])
  stipendAmount     Float    @default(2500)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([providerId])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  providerId    String?
  customerId    String?
  customerEmail String
  customerName  String   @default("")
  type          String   @default("special_info")
  granted       Boolean  @default(true)
  version       String   @default("1.2")
  grantedAt     DateTime @default(now())
  revokedAt     DateTime?

  @@index([customerEmail])
  @@index([providerId])
}

model CustomerLoyalty {
  id                    String   @id @default(cuid())
  email                 String   @unique
  customerName          String
  tier                  String   @default("HER Circle")
  preferredStylist      String   @default("Nomvula Dlamini (Master Texture Specialist)")
  hairType              String   @default("Type 4C Coily Texture, High Porosity")
  skinConcerns          String   @default("Hydration Focus, Gentle Botanical Care")
  allergies             String   @default("Sulfates & Mineral Oils (Prefers Shea, Argan & Jojoba botanicals)")
  beautyPoints          Int      @default(4850)
  referralCode          String   @default("HER-CIRCLE")
  birthdayOfferEligible Boolean  @default(true)
  savedCardLast4        String   @default("4921 (Standard Bank Student Debit)")
  memberSince           String   @default("January 2024")
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Governance, Audit & Operations
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  entity        String
  entityId      String
  action        String
  actorId       String
  actorEmail    String
  actorRole     String
  changes       Json?
  justification String?
  ipAddress     String?
  providerId    String?
  timestamp     DateTime @default(now())

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([providerId, timestamp])
  @@index([timestamp])
}

model CronLock {
  jobName   String   @id
  lockedBy  String
  lockedAt  DateTime @default(now())
  expiresAt DateTime
}

model RetentionPolicy {
  id            String    @id @default(cuid())
  entity        String    @unique
  retentionDays Int       @default(365)
  enabled       Boolean   @default(false)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
