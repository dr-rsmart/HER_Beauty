{
  "name": "BookingTrack-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma": true
  },
  "description": "BookingTrack API server — Express 5 + Prisma + PostgreSQL + SSE Real-time",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:setup": "prisma db push --schema=prisma/schema.prisma && tsx src/seed.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "seed": "tsx src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
