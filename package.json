{
  "name": "BookingTrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BookingTrack — multi-tenant appointment booking, professional scheduling, and business management platform across South Africa",
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma": true
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd server && npm run dev",
    "dev:web": "vite",
    "build": "vite build && cd server && npm run build",
    "start": "node scripts/production-start.mjs",
    "predeploy": "node scripts/predeploy-check.mjs",
    "setup": "npm install && cd server && npm install && npm run db:setup",
    "seed": "cd server && npm run seed",
    "stress:seed": "node stress/seed-stress-data.mjs",
    "stress:run": "k6 run stress/suite-orchestrator.js",
    "typecheck": "tsc -p ./tsconfig.json --noEmit && cd server && npx tsc --noEmit",
    "test": "vitest run && cd server && npm test",
    "test:server": "cd server && npm test",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.475.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
